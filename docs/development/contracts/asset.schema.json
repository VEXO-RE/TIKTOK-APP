{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asset",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "ownerTenantRef": {
      "type": "string",
      "minLength": 1
    },
    "sourceType": {
      "enum": [
        "owned",
        "licensed",
        "generated"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "rightsStatus": {
      "enum": [
        "pending",
        "approved",
        "revoked",
        "rejected"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mimeType": {
      "type": "string",
      "minLength": 1
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "width": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "height": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "durationSeconds": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "recipeVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "qcStatus": {
      "enum": [
        "pending",
        "passed",
        "failed"
      ]
    },
    "storageRef": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "ownerTenantRef",
    "sourceType",
    "sourceRefs",
    "rightsStatus",
    "sha256",
    "mimeType",
    "bytes",
    "width",
    "height",
    "durationSeconds",
    "recipeVersion",
    "qcStatus",
    "storageRef"
  ]
}
