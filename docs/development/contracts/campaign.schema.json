{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campaign",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "ownerTenantRef": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "organic",
        "paid"
      ]
    },
    "objective": {
      "enum": [
        "awareness",
        "consideration",
        "traffic",
        "leads",
        "sales"
      ]
    },
    "audienceSourceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "startsAt": {
      "type": "string",
      "format": "date-time"
    },
    "endsAt": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "contentRevisionRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "destinations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Destination",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "verificationStatus": {
            "enum": [
              "planned",
              "verified",
              "blocked"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "url",
          "verificationStatus",
          "evidenceRefs"
        ]
      }
    },
    "budget": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "Budget",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "minorUnits": {
              "type": "integer",
              "minimum": 0
            },
            "approvalRef": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "currency",
            "minorUnits",
            "approvalRef"
          ]
        }
      ]
    },
    "measurementPlanRef": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "ownerTenantRef",
    "mode",
    "objective",
    "audienceSourceRefs",
    "startsAt",
    "endsAt",
    "timezone",
    "contentRevisionRefs",
    "destinations",
    "budget",
    "measurementPlanRef"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "paid"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "budget": {
            "type": "object"
          }
        }
      }
    }
  ]
}
