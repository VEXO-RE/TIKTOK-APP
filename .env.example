# ============================================================
# SERVER
# ============================================================

NODE_ENV=development
PORT=4100

APP_BASE_URL=
APP_WEBSITE_URL=https://shopinistameta.com

# ============================================================
# TIKTOK FOR DEVELOPERS
# NO agregar valores hasta crear/configurar la app real.
# ============================================================

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Producción prevista:
# https://api.shopinistameta.com/auth/tiktok/callback
TIKTOK_REDIRECT_URI=

# ============================================================
# FEATURES
# ============================================================

TIKTOK_LOGIN_ENABLED=false
TIKTOK_CONTENT_UPLOAD_ENABLED=false
TIKTOK_DIRECT_POST_ENABLED=false

TIKTOK_BUSINESS_ENABLED=false
TIKTOK_CAMPAIGNS_WRITE_ENABLED=false

TIKTOK_SHOP_ENABLED=false

TIENDANUBE_ENABLED=false
WHATSAPP_ENABLED=false

AUTOMATION_ENABLED=false
AUTOMATION_AUTO_PUBLISH=false

MCP_ENABLED=false
MCP_READONLY=true
# Carpeta local permitida para la herramienta MCP video_inspect_local.
TIKTOK_MCP_MEDIA_DIR=data/mcp-media

# ============================================================
# FUTURE INTEGRATIONS
# Nunca guardar secrets reales en .env.example
# ============================================================

TIENDANUBE_STORE_ID=
TIENDANUBE_ACCESS_TOKEN=
TIENDANUBE_API_BASE_URL=https://api.tiendanube.com/2025-03
TIENDANUBE_LOCALE=es
# Tiendanube exige identificar la aplicación en cada llamada. Sustituye solo el contacto público si aplica.
TIENDANUBE_USER_AGENT=ShopinistaMeta TikTok (support@shopinistameta.com)

WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
